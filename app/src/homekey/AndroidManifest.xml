<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Visibilité du launcher cible (Android 11+) -->
    <queries>
        <package android:name="com.spocky.projengmenu" />
    </queries>

    <application android:label="@string/homekey_label">

        <service
            android:name=".HomeKeyService"
            android:label="@string/homekey_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>
    </application>
</manifest>
